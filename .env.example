# Database (MySQL) — password is URL-encoded (@ -> %40)
DATABASE_URL="mysql://root:PASSWORD@localhost:3306/premium_gym"

PORT=4100
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:4100
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:19006

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=200

# Initial super admin (seed only)
SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=change-me

# Email (verification + password reset codes). Any SMTP provider works.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-letter App Password from myaccount.google.com/apppasswords>
# Leave empty in development: codes are then shown in the app for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FitFlow <no-reply@example.com>"
